// Redireciona www.kapota.com.br pro domínio principal. Push na main que mexe aqui publica sozinho
// (workflow publicar-www.yml, desde 18/11/2026). À mão:
//   cd tools/www && npx wrangler@4 deploy
{
  "name": "kapota-www",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "www.kapota.com.br/*", "zone_name": "kapota.com.br" }]
}
